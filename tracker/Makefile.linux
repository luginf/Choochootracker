# Linux platform identifier
PLATFORM = linux

include Makefile.common

# Linux-specific settings
LIBS = $(COMMON_LIBS) platforms/sdl2 ../chipnomad_lib/external/rtmidi
OUTPUT_EXT =

XTRA_CFLAGS = -DDESKTOP_BUILD -DGAMEPAD_SUPPORT -D__LINUX_ALSA__ -D__LINUX_ALSASEQ__
XTRA_LIBS = -lSDL2 -lm -lasound
CFLAGS = $(COMMON_CFLAGS) $(INCLUDES) $(SOURCES) $(XTRA_CFLAGS)
OUTPUT = -o $(BUILD)/choochootracker$(OUTPUT_EXT)

APPNAME = ChooChooTracker

# Simple Linux build
.PHONY: linux
linux:
	$(call build_target)

# Docker-based Linux build (internal target)
.PHONY: .linux-docker
.linux-docker:
	mkdir -p $(BUILD)
	g++ $(CFLAGS) $(XTRA_LIBS) $(OUTPUT)
	chmod +x $(BUILD)/choochootracker

# Linux deployment using Docker
.PHONY: linux-deploy
linux-deploy:
	@echo "Creating Linux deployment package..."
	@./check-docker.sh || exit 1
	@echo "Building Linux Docker image..."
	@docker build --platform linux/amd64 -f Dockerfile.linux -t chipnomad-linux-builder . || (echo "Error: Failed to build Docker image" && exit 1)
	@docker run --platform linux/amd64 --rm -v "$$(pwd)/..:/workspace" -w /workspace/tracker chipnomad-linux-builder make -f Makefile.linux .linux-docker
	@mkdir -p ../releases
	@mkdir -p $(BUILD)/$(APPNAME)-Linux
	@cp $(BUILD)/choochootracker $(BUILD)/$(APPNAME)-Linux/
	@cp -r packaging/common/* $(BUILD)/$(APPNAME)-Linux/
	@cp packaging/linux/README.txt $(BUILD)/$(APPNAME)-Linux/
	@cp ../docs/USER_MANUAL.md $(BUILD)/$(APPNAME)-Linux/
	@mkdir -p $(BUILD)/$(APPNAME)-Linux/licenses
	@cp ../LICENSE packaging/portmaster/license/* $(BUILD)/$(APPNAME)-Linux/licenses/
	@echo '#!/bin/bash' > $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@echo 'cd "$$(dirname "$$0")"' >> $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@echo 'exec ./choochootracker "$$@"' >> $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@chmod +x $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@cd $(BUILD) && tar -czf $(APPNAME)-$$(date +%Y-%m-%d)-$(VERSION)-Linux-x86_64.tar.gz $(APPNAME)-Linux
	@mv $(BUILD)/$(APPNAME)-*-Linux-x86_64.tar.gz ../releases/
	@echo "Linux package created in ../releases/"

# Linux package build (tar.gz)
.PHONY: linux-package
linux-package: linux
	@echo "Creating Linux package..."
	@mkdir -p $(BUILD)/$(APPNAME)-Linux
	@cp $(BUILD)/choochootracker $(BUILD)/$(APPNAME)-Linux/
	@cp -r packaging/common/* $(BUILD)/$(APPNAME)-Linux/
	@cp packaging/linux/README.txt $(BUILD)/$(APPNAME)-Linux/
	@cp ../docs/USER_MANUAL.md $(BUILD)/$(APPNAME)-Linux/
	@mkdir -p $(BUILD)/$(APPNAME)-Linux/licenses
	@cp ../LICENSE packaging/portmaster/license/* $(BUILD)/$(APPNAME)-Linux/licenses/
	@echo '#!/bin/bash' > $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@echo 'cd "$$(dirname "$$0")"' >> $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@echo 'exec ./choochootracker "$$@"' >> $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@chmod +x $(BUILD)/$(APPNAME)-Linux/chipnomad.sh
	@cd $(BUILD) && tar -czf $(APPNAME)-$$(date +%Y-%m-%d)-$(VERSION)-Linux-$(shell uname -m).tar.gz $(APPNAME)-Linux
	@echo "Linux package created: $(BUILD)/$(APPNAME)-$$(date +%Y-%m-%d)-$(VERSION)-Linux-$(shell uname -m).tar.gz"

# AppImage (Linux x86_64). Bundles only the libraries that aren't
# guaranteed present on the host (SDL2 and its libsamplerate dependency -
# the same ones the plain tar.gz release's README tells users to
# `apt install`); everything else (X11, ALSA, glibc...) resolves from the
# host system, to avoid the ABI-mismatch risk of bundling core OS libraries.
APPIMAGE_LIBS = /lib/x86_64-linux-gnu/libSDL2-2.0.so.0 /lib/x86_64-linux-gnu/libsamplerate.so.0

.PHONY: appimage
appimage: linux
	@echo "Creating AppImage..."
	@rm -rf $(BUILD)/$(APPNAME).AppDir
	@mkdir -p $(BUILD)/$(APPNAME).AppDir/usr/bin
	@mkdir -p $(BUILD)/$(APPNAME).AppDir/usr/lib
	@cp $(BUILD)/choochootracker $(BUILD)/$(APPNAME).AppDir/usr/bin/
	@for lib in $(APPIMAGE_LIBS); do \
		if [ ! -f "$$lib" ]; then echo "Error: $$lib not found - install libsdl2-2.0-0" && exit 1; fi; \
		cp -L "$$(readlink -f "$$lib")" $(BUILD)/$(APPNAME).AppDir/usr/lib/ || exit 1; \
	done
	@mkdir -p $(BUILD)/$(APPNAME).AppDir/usr/share/choochootracker/common
	@cp -r packaging/common/* $(BUILD)/$(APPNAME).AppDir/usr/share/choochootracker/common/
	@cp packaging/linux-appimage/AppRun $(BUILD)/$(APPNAME).AppDir/
	@chmod +x $(BUILD)/$(APPNAME).AppDir/AppRun
	@cp packaging/linux-appimage/choochootracker.desktop $(BUILD)/$(APPNAME).AppDir/
	@cp ../docs/play-store-assets/ChooChooTracker-play-icon-512.png $(BUILD)/$(APPNAME).AppDir/choochootracker.png
	@mkdir -p ../releases
	@if command -v appimagetool >/dev/null 2>&1; then TOOL=appimagetool; \
	else \
		echo "appimagetool not found, downloading it to ../.tmp..."; \
		mkdir -p ../.tmp; \
		curl -L -o ../.tmp/appimagetool https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage; \
		chmod +x ../.tmp/appimagetool; \
		TOOL=../.tmp/appimagetool; \
	fi; \
	ARCH=x86_64 $$TOOL $(BUILD)/$(APPNAME).AppDir ../releases/$(APPNAME)-$$(date +%Y-%m-%d)-$(VERSION)-x86_64.AppImage
	@echo "AppImage created in ../releases/"

.PHONY: clean
clean:
	rm -rf $(BUILD)
